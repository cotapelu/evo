# Evo Agent Environment Configuration
# Copy this file to ~/.pi/agent/.env or set these environment variables

# API Keys (choose one or both)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-openai-...

# Pi Configuration (optional)
PI_CODING_AGENT_DIR=~/.pi/agent
PI_OFFLINE=0
PI_TELEMETRY=1

# Evo-specific (can also be set in settings.json)
# EVO_AUTO_APPLY=false
# EVO_ENABLE_WEB_UI=false
# EVO_WEB_UI_PORT=3000
