# Agent OS Configuration v1.1

# Core
NODE_ENV=production
AGENT_LOG_LEVEL=info
AGENT_LOG_PATH=agent.log

# Persistence
AGENT_ENABLE_DATABASE=true
AGENT_DB_PATH=/data/agent.db
AGENT_MEMORY_PATH=memory.json

# HTTP Metrics (Port 3456)
AGENT_METRICS_PORT=3456
AGENT_ENABLE_METRICS=true
AGENT_API_RATE_LIMIT=60

# WebSocket (Port 3457)
AGENT_ENABLE_WEBSOCKET=true
AGENT_WEBSOCKET_PORT=3457

# Replication & Orchestration
AGENT_ENABLE_REPLICATION=true
AGENT_ENABLE_ORCHESTRATION=true
AGENT_MAX_CHILDREN=10

# Resource Limits
AGENT_RESOURCE_MAX_MEMORY=100
AGENT_RESOURCE_MAX_CPU=5000

# Security
AGENT_SECURITY_REQUIRE_AUTH=false
AGENT_SECURITY_ALLOWED_ORIGINS=localhost,127.0.0.1
AGENT_JWT_SECRET=change-this-to-a-random-secret

# Cluster Mode (Experimental)
AGENT_ENABLE_CLUSTER=false
AGENT_CLUSTER_WORKERS=2

# Plugins
AGENT_ENABLE_PLUGINS=true
AGENT_PLUGINS_PATH=plugins
