{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "node16",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@extensions/*": ["./src/plugin/extensions/*"],
      "@typescript-eslint/parser": ["./node_modules/@typescript-eslint/parser/dist/index.js"]
    },
    "types": ["node", "vitest"],
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/tests/**/*", "src/**/__tests__/**", "src/benchmarks/**"]
}
