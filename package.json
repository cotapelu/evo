{
  "name": "evo",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "description": "Evo Coding Agent CLI - Professional AI coding assistant",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "evo": "dist/cli.js"
  },
  "scripts": {
    "generate-custom-models": "tsx scripts/generate-custom-models.ts",
    "build": "npm run generate-custom-models && tsc -p tsconfig.build.json && chmod +x dist/cli.js && cp -r src/extensions/tools/skill-reader/skills dist/extensions/tools/skill-reader/ && cp -r src/extensions/capability-system/plugins dist/extensions/capability-system/",
    "start": "node dist/cli.js",
    "dev": "npm run generate-custom-models && tsx src/cli.ts",
    "lint": "eslint src/**/*.ts --fix",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test",
    "benchmark": "tsx src/benchmarks/index.ts",
    "benchmark:team": "tsx src/benchmarks/team-performance.ts",
    "benchmark:codebase": "tsx src/benchmarks/codebase-performance.ts",
    "benchmark:memory": "tsx src/benchmarks/memory-tool.ts",
    "benchmark:tui": "tsx src/benchmarks/tui-rendering.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.80.2",
    "@earendil-works/pi-ai": "^0.80.2",
    "@earendil-works/pi-coding-agent": "^0.80.2",
    "@earendil-works/pi-tui": "^0.80.2",
    "chalk": "^5.6.2",
    "globals": "^17.5.0",
    "minimatch": "^10.2.5",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/minimatch": "^5.1.2",
    "@types/node": "^20.19.39",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitest/coverage-v8": "^4.1.5",
    "c8": "^8.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.5"
  }
}
