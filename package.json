{
  "name": "evo-agent",
  "version": "0.0.1",
  "description": "Self-Evolving AI Agent System",
  "type": "module",
  "main": "dist/src/main.js",
  "scripts": {
    "start": "node dist/src/main.js",
    "dev": "ts-node --esm src/main.ts",
    "build": "tsc",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "lint": "eslint src/**/*.ts",
    "evolve": "node dist/src/evolution/cli.js",
    "evolve:dry": "node dist/src/evolution/cli.js --dry"
  },
  "bin": {
    "evo": "./dist/src/main.js"
  },
  "keywords": [
    "agent",
    "self-evolving",
    "autonomous",
    "ai",
    "coding-agent"
  ],
  "author": "Self-Evolving System",
  "license": "MIT",
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/glob": "^8.1.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.75.3",
    "diff": "^5.1.0"
  }
}
