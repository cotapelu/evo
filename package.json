{
  "name": "evo-agent",
  "version": "2.2.0",
  "description": "Self-Evolving AI Agent System with auto-apply, safety guards, agent messaging, and comprehensive metrics",
  "type": "module",
  "main": "evo.ts",
  "scripts": {
    "start": "node dist/evo.js",
    "dev": "ts-node --esm evo.ts",
    "build": "tsc",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "lint": "eslint src/**/*.ts"
  },
  "bin": {
    "evo": "./dist/evo.js"
  },
  "keywords": [
    "agent",
    "self-evolving",
    "autonomous",
    "ai",
    "coding-agent"
  ],
  "author": "Self-Evolving System",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.74.0"
  }
}
