{
  "name": "evo",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "description": "Tau Coding Agent CLI - Professional AI coding assistant",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "evo": "dist/cli.js"
  },
  "scripts": {
    "generate-custom-models": "tsx scripts/generate-custom-models.ts",
    "build": "npm run generate-custom-models && tsc -p tsconfig.build.json && chmod +x dist/cli.js && mkdir -p dist/addon/extensions/capability-system dist/addon/extensions/tools/skill-reader && cp -r src/addon/extensions/tools/skill-reader/skills dist/addon/extensions/tools/skill-reader/ && cp -r src/addon/extensions/capability-system/plugins dist/addon/extensions/capability-system/",
    "start": "node dist/cli.js",
    "dev": "npm run generate-custom-models && tsx src/cli.ts",
    "lint": "eslint src/**/*.ts --fix",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test",
    "prepare": "husky install"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.80.3",
    "@earendil-works/pi-ai": "^0.80.3",
    "@earendil-works/pi-coding-agent": "^0.80.3",
    "@earendil-works/pi-tui": "^0.80.3",
    "chalk": "^5.6.2",
    "globals": "^17.5.0",
    "minimatch": "^10.2.5",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/minimatch": "^5.1.2",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitest/coverage-v8": "^4.1.5",
    "c8": "^8.0.0",
    "eslint": "^9.0.0",
    "husky": "^9.1.6",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
